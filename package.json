{
  "name": "@offbynan/pi-cursor-provider",
  "version": "0.7.0",
  "description": "Pi extension providing access to Cursor models via OAuth and a local OpenAI-compatible gRPC proxy",
  "type": "module",
  "license": "MIT",
  "author": "offbynan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/offbynan/pi-cursor-provider.git"
  },
  "homepage": "https://github.com/offbynan/pi-cursor-provider#readme",
  "bugs": {
    "url": "https://github.com/offbynan/pi-cursor-provider/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "cursor",
    "oauth",
    "proxy",
    "grpc",
    "openai-compatible"
  ],
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.84.0 <1.0.0",
    "@earendil-works/pi-coding-agent": ">=0.84.0 <1.0.0"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "index.ts",
    "model-ids.ts",
    "cursor-errors.ts",
    "secure-log.ts",
    "auth.ts",
    "proxy.ts",
    "h2-bridge.mjs",
    "cursor-models-raw.json",
    "proto/agent_pb.ts",
    "README.md",
    "CHANGELOG.md",
    "scripts/debug-log-timeline.mjs",
    "scripts/refresh-models.mjs",
    "scripts/smoke-live.mjs",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.10.2"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "node scripts/smoke-live.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "prepack": "npm run check 1>&2",
    "prepublishOnly": "npm run check",
    "refresh-models": "node scripts/refresh-models.mjs",
    "debug:timeline": "node scripts/debug-log-timeline.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.3"
  }
}
